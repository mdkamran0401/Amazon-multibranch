
pipeline {
    agent { label 'Node1' }

    stages {
        stage('COMPILE STAGE') {
            steps {
                dir('Amazon') {
                    sh 'mvn compile'
                }
            }
        }

        stage('TEST STAGE') {
            steps {
                dir('Amazon') {
                    sh 'mvn test'
                }
            }
        }

        stage('BUILD AND INSTALL STAGE') {
            steps {
                dir('Amazon') {
                    sh 'mvn clean install'
                }
            }
        }
        stage('Deploy') {
    steps {
        sh 'cp Amazon/Amazon-Web/target/*.war /home/kamra/apachetomcat/apache-tomcat-9.0.123/webapps/Amazon.war'
         }
       }
    }

    post {
        success {
            emailext(
                to: 'kamran.abc.reports@gmail.com',
                subject: "Jenkins Pipeline - ${env.JOB_NAME} - SUCCESS",
                body: "Pipeline completed successfully. Build URL: ${env.BUILD_URL}"
            )
        }

        failure {
            emailext(
                to: 'kamran.abc.reports@gmail.com',
                subject: "Jenkins Pipeline - ${env.JOB_NAME} - FAILURE",
                body: "Pipeline failed. Please check the console output: ${env.BUILD_URL}"
            )
        }
    }
}
