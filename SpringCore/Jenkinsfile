pipeline {
    agent { label 'Node1' }

    stages {
        stage('COMPILE SPRINGCORE') {
            steps {
                         sh 'mvn compile'
                }
            }
        }

        stage('TEST SPRINGCORE') {
            steps {
                       sh 'mvn test'
                }
            }
        }

        stage('BUILD AND INSTALL SPRINGCORE') {
            steps {
                              sh 'mvn clean install'
                }
            }
        }
    }
}
